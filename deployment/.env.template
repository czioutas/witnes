# Witnes API Environment Configuration
# Copy this file to /opt/witnes/.env and fill in the values

# ============================================
# Database Connection Strings
# ============================================
ConnectionStrings__Primary="Host=localhost;Database=witnes;Username=witnes;Password=YOUR_POSTGRES_PASSWORD;Port=5432;Pooling=true;Maximum Pool Size=20;Minimum Pool Size=5;"
ConnectionStrings__Replica="Host=localhost;Database=witnes;Username=witnes;Password=YOUR_POSTGRES_PASSWORD;Port=5432;Pooling=true;Maximum Pool Size=20;Minimum Pool Size=5;"

# ============================================
# JWT Token Settings
# ============================================
TokenProviderSettings__ShortExpiration="8:00"
TokenProviderSettings__LongExpiration="2.00:00:00"
TokenProviderSettings__SecretKey="YOUR_SECRET_KEY_HERE"
TokenProviderSettings__Issuer="https://api.witnes.io"
TokenProviderSettings__Audience="https://witnes.io"

# ============================================
# SMTP Settings (Mailtrap)
# ============================================
SmtpSettings__ApiKey="YOUR_MAILTRAP_API_KEY"
SmtpSettings__From="no-reply@witnes.io"
SmtpSettings__VerifyEmailTemplateId="f5155f50-ce74-4f5c-9fe7-cc567fa98e65"
SmtpSettings__PasswordResetTemplateId="3cf223f4-6ab6-40ad-9837-f6f291033b2a"
SmtpSettings__UserInvitationTemplateId="9bda3f2d-a986-44b9-9b3e-88581778fa13"
SmtpSettings__MailtrapAccountId="2576420"
SmtpSettings__JoinRequestListId="171166"

# ============================================
# Application URLs
# ============================================
ApplicationSettings__ApiBaseUrl="https://api.witnes.io"
ApplicationSettings__ApplicationBaseUrl="https://witnes.io"

# HOST URL ("urls" root key)
urls="http://::7070"

# ============================================
# CORS Settings
# ============================================
CorsSettings__Origins="https://witnes.io,https://www.witnes.io"

# ============================================
# RabbitMQ Settings (Docker container)
# ============================================
RabbitMQSettings__Host=localhost
RabbitMQSettings__Port=5672
RabbitMQSettings__Username=witnes
RabbitMQSettings__Password=YOUR_RABBITMQ_PASSWORD
RabbitMQSettings__VirtualHost=/
RabbitMQSettings__ConnectionName=Witnes-Production
RabbitMQSettings__ConnectionString=amqp://witnes:YOUR_RABBITMQ_PASSWORD@localhost:5672/

# ============================================
# Redis Settings (Docker container)
# ============================================
RedisSettings__ConnectionString=localhost:6379,abortConnect=false,ssl=false
RedisSettings__IpAddress=localhost
RedisSettings__Port=6379
RedisSettings__Password=
RedisSettings__UseSsl=false

# ============================================
# Docker Container Initialization Variables
# (Only needed if running infrastructure via Docker)
# ============================================
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
RABBITMQ_DEFAULT_USER=witnes
RABBITMQ_DEFAULT_PASS=YOUR_RABBITMQ_PASSWORD