---
import PublicLayout from "../layouts/PublicLayout.astro";
import Navbar from "../components/landing/Navbar.astro";
import Footer from "../components/landing/Footer.astro";
import { Card, CardContent, CardHeader, CardTitle } from "../components/ui/card";
import { Badge } from "../components/ui/badge";
import { Button } from "../components/ui/button";
import { Separator } from "../components/ui/separator";
---

<PublicLayout
  title="Imprint | Legal Information | Witnes"
  description="Company information and legal details for Witnes."
  canonical="/imprint"
>
  <div class="min-h-screen flex flex-col selection:bg-[#A68B6A] selection:text-white relative">
    <div class="relative z-10">
      <Navbar />
      <main class="flex-grow">
        <!-- Header Section -->
        <section class="relative overflow-hidden pb-20 pt-32 md:pb-32 md:pt-44 border-b">
          <!-- Subtle grid background -->
          <div
            class="pointer-events-none absolute inset-0 opacity-[0.4]"
            style="background-image: linear-gradient(hsl(var(--border)) 1px, transparent 1px), linear-gradient(to right, hsl(var(--border)) 1px, transparent 1px); background-size: 60px 60px;"
          >
          </div>

          <!-- Glow effect -->
          <div
            class="pointer-events-none absolute left-1/2 top-0 -translate-x-1/2 h-[500px] w-[800px] rounded-full bg-muted blur-[120px]"
          >
          </div>

          <div class="relative mx-auto max-w-6xl px-6">
            <div class="mx-auto max-w-3xl text-center">
              <!-- Badge -->
              <div
                class="mb-8 inline-flex items-center gap-2 rounded-full border border-border bg-secondary px-4 py-1.5 text-sm text-foreground"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-3.5 w-3.5"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="16" x2="12" y2="12"></line>
                  <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <span>Legal</span>
              </div>

              <h1
                class="text-balance text-4xl font-bold leading-tight tracking-tight text-foreground md:text-6xl lg:text-7xl"
              >
                Imprint
              </h1>

              <p
                class="mx-auto mt-6 max-w-2xl text-pretty text-lg leading-relaxed text-muted-foreground md:text-xl"
              >
                Company information and legal details for Witnes.
              </p>

              <p class="mt-8 text-sm text-muted-foreground">
                All required information according to applicable law.
              </p>
            </div>
          </div>
        </section>

        <!-- Main Imprint Content -->
        <section class="section-frame py-32 md:py-48 px-6 md:px-12 bg-white">
          <div class="max-w-4xl mx-auto space-y-12">
            <!-- Company Information -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">01</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest">Company Information</CardTitle>
                </div>
              </CardHeader>
              <CardContent className="space-y-4">
                <p class="text-lg text-zinc-600">
                  <strong class="text-black">Witnes</strong> by <strong class="text-black">ZITA CH Single Member Private Company</strong>
                </p>
                <p class="text-lg text-zinc-600">
                  Promitheos 33<br />
                  Thessaloniki 546 29<br />
                  Greece
                </p>
              </CardContent>
            </Card>

            <!-- Contact -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">02</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest">Contact</CardTitle>
                </div>
              </CardHeader>
              <CardContent>
                <p class="text-lg text-zinc-600">
                  <strong class="text-black">Email:</strong>
                  <a
                    href="mailto:support@witnes.io"
                    class="text-[#7A9B79] hover:text-black transition-colors underline decoration-[#7A9B79]/30 underline-offset-4 ml-2"
                  >
                    support@witnes.io
                  </a>
                </p>
              </CardContent>
            </Card>

            <!-- Legal -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">03</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest">Legal</CardTitle>
                </div>
              </CardHeader>
              <CardContent className="space-y-4">
                <p class="text-lg text-zinc-600">
                  <strong class="text-black">Representative:</strong> Chris Zioutas
                </p>
                <p class="text-lg text-zinc-600">
                  <strong class="text-black">GEMI No:</strong> 183435606000
                </p>
              </CardContent>
            </Card>

            <!-- Closing -->
            <Separator className="my-12" />
            <div class="flex flex-col items-center gap-8">
              <Button variant="outline" className="gap-2" asChild client:load>
                <a href="/">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 19-7-7 7-7"/>
                    <path d="M19 12H5"/>
                  </svg>
                  Back to Home
                </a>
              </Button>
            </div>
          </div>
        </section>
      </main>
      <Footer />
    </div>
  </div>
</PublicLayout>
