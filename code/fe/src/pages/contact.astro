---
import PublicLayout from "../layouts/PublicLayout.astro";
import Navbar from "../components/landing/Navbar.astro";
import Footer from "../components/landing/Footer.astro";
import { Button } from "../components/ui/button";
---

<PublicLayout
  title="Contact | Witnes"
  description="Get in touch with the Witnes team. We're here to help."
  canonical="/contact"
>
  <div
    class="min-h-screen flex flex-col selection:bg-[#A68B6A] selection:text-white relative"
  >
    <div class="relative z-10">
      <Navbar />
      <main class="flex-grow">
        <!-- Header Section -->
        <section
          class="relative overflow-hidden pb-20 pt-32 md:pb-32 md:pt-44 border-b"
        >
          <!-- Subtle grid background -->
          <div
            class="pointer-events-none absolute inset-0 opacity-[0.4]"
            style="background-image: linear-gradient(hsl(var(--border)) 1px, transparent 1px), linear-gradient(to right, hsl(var(--border)) 1px, transparent 1px); background-size: 60px 60px;"
          >
          </div>

          <!-- Glow effect -->
          <div
            class="pointer-events-none absolute left-1/2 top-0 -translate-x-1/2 h-[500px] w-[800px] rounded-full bg-muted blur-[120px]"
          >
          </div>

          <div class="relative mx-auto max-w-6xl px-6">
            <div class="mx-auto max-w-3xl text-center">
              <!-- Badge -->
              <div
                class="mb-8 inline-flex items-center gap-2 rounded-full border border-border bg-secondary px-4 py-1.5 text-sm text-foreground"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-3.5 w-3.5"
                >
                  <path
                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                  ></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <span>Contact</span>
              </div>

              <h1
                class="text-balance text-4xl font-bold leading-tight tracking-tight text-foreground md:text-6xl lg:text-7xl"
              >
                Get in Touch
              </h1>

              <p
                class="mx-auto mt-6 max-w-2xl text-pretty text-lg leading-relaxed text-muted-foreground md:text-xl"
              >
                Have a question, need help, or want to learn more? Reach out to
                the right team below.
              </p>
            </div>
          </div>
        </section>

        <!-- Contact Content -->
        <section class="py-16 md:py-24 px-6 bg-background">
          <div class="mx-auto max-w-3xl space-y-20">
            <!-- 01: Support -->
            <div>
              <div class="flex items-baseline gap-4 mb-4">
                <span
                  class="text-4xl font-extralight text-muted-foreground/40 font-mono"
                  >01</span
                >
                <p
                  class="text-sm font-semibold uppercase tracking-widest text-muted-foreground"
                >
                  Support
                </p>
              </div>
              <h2
                class="text-2xl font-bold tracking-tight text-foreground md:text-3xl"
              >
                Technical Support
              </h2>
              <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
                Having trouble with your integration, dashboard, or account?
                Our support team is here to help.
              </p>
              <p class="mt-4">
                <a
                  href="mailto:support@witnes.io"
                  class="text-lg font-semibold text-foreground underline underline-offset-4 decoration-muted-foreground/40 hover:decoration-foreground transition-colors"
                >
                  support@witnes.io
                </a>
              </p>
            </div>

            <!-- Divider -->
            <div class="h-px bg-border"></div>

            <!-- 02: Sales -->
            <div>
              <div class="flex items-baseline gap-4 mb-4">
                <span
                  class="text-4xl font-extralight text-muted-foreground/40 font-mono"
                  >02</span
                >
                <p
                  class="text-sm font-semibold uppercase tracking-widest text-muted-foreground"
                >
                  Sales
                </p>
              </div>
              <h2
                class="text-2xl font-bold tracking-tight text-foreground md:text-3xl"
              >
                Sales & Partnerships
              </h2>
              <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
                Interested in Witnes for your organization, or want to discuss
                custom plans and partnerships?
              </p>
              <p class="mt-4">
                <a
                  href="mailto:sales@witnes.io"
                  class="text-lg font-semibold text-foreground underline underline-offset-4 decoration-muted-foreground/40 hover:decoration-foreground transition-colors"
                >
                  sales@witnes.io
                </a>
              </p>
            </div>

            <!-- Divider -->
            <div class="h-px bg-border"></div>

            <!-- 03: General -->
            <div>
              <div class="flex items-baseline gap-4 mb-4">
                <span
                  class="text-4xl font-extralight text-muted-foreground/40 font-mono"
                  >03</span
                >
                <p
                  class="text-sm font-semibold uppercase tracking-widest text-muted-foreground"
                >
                  General
                </p>
              </div>
              <h2
                class="text-2xl font-bold tracking-tight text-foreground md:text-3xl"
              >
                Everything Else
              </h2>
              <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
                For anything else — feedback, press inquiries, or just to say
                hello.
              </p>
              <p class="mt-4">
                <a
                  href="mailto:chris@witnes.io"
                  class="text-lg font-semibold text-foreground underline underline-offset-4 decoration-muted-foreground/40 hover:decoration-foreground transition-colors"
                >
                  chris@witnes.io
                </a>
              </p>
            </div>

            <!-- Divider -->
            <div class="h-px bg-border"></div>

            <!-- Closing -->
            <div class="flex flex-col items-center gap-4">
              <p class="text-base text-muted-foreground">
                We typically respond within one business day.
              </p>
              <Button variant="outline" className="gap-2" asChild client:load>
                <a href="/">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m12 19-7-7 7-7"></path>
                    <path d="M19 12H5"></path>
                  </svg>
                  Back to Home
                </a>
              </Button>
            </div>
          </div>
        </section>
      </main>
      <Footer />
    </div>
  </div>
</PublicLayout>
