---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import DashboardPage from "../../../components/DashboardPage.tsx";

const { userId } = Astro.params;
---

<DashboardLayout title={`Visitor ${userId} - Witnes`}>
  <DashboardPage
    client:only="react"
    page="visitor-detail"
    title={`Visitor ${userId}`}
    description="View visitor activity and page loads"
    userId={userId!}
  />
</DashboardLayout>
