---
import PublicLayout from "../../layouts/PublicLayout.astro";
import { ForgotPasswordWrapper } from "../../components/landing/ForgotPasswordWrapper";
import Navbar from "../../components/landing/Navbar.astro";
---

<PublicLayout
  title="Forgot Password - Witnes"
  description="Reset your Witnes password"
  canonical="/authenticate/forgot-password"
>
  <Navbar />
  <main class="flex min-h-svh w-full items-center justify-center p-6 md:p-10">
    <div class="w-full max-w-sm">
      <ForgotPasswordWrapper client:load />
    </div>
  </main>
</PublicLayout>
