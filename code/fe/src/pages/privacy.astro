---
import PublicLayout from "../layouts/PublicLayout.astro";
import Navbar from "../components/landing/Navbar.astro";
import Footer from "../components/landing/Footer.astro";
import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
} from "../components/ui/card";
import { Badge } from "../components/ui/badge";
import { Button } from "../components/ui/button";
import { Separator } from "../components/ui/separator";
---

<PublicLayout
  title="Privacy Policy | Witnes"
  description="How we handle your data. Privacy by Design, no cookies, no cross-site tracking. Your data stays yours."
  canonical="/privacy"
>
  <div
    class="min-h-screen flex flex-col selection:bg-[#A68B6A] selection:text-white relative"
  >
    <div class="relative z-10">
      <Navbar />
      <main class="flex-grow">
        <!-- Header Section -->
        <section
          class="relative overflow-hidden pb-20 pt-32 md:pb-32 md:pt-44 border-b"
        >
          <!-- Subtle grid background -->
          <div
            class="pointer-events-none absolute inset-0 opacity-[0.4]"
            style="background-image: linear-gradient(hsl(var(--border)) 1px, transparent 1px), linear-gradient(to right, hsl(var(--border)) 1px, transparent 1px); background-size: 60px 60px;"
          >
          </div>

          <!-- Glow effect -->
          <div
            class="pointer-events-none absolute left-1/2 top-0 -translate-x-1/2 h-[500px] w-[800px] rounded-full bg-muted blur-[120px]"
          >
          </div>

          <div class="relative mx-auto max-w-6xl px-6">
            <div class="mx-auto max-w-3xl text-center">
              <!-- Badge -->
              <div
                class="mb-8 inline-flex items-center gap-2 rounded-full border border-border bg-secondary px-4 py-1.5 text-sm text-foreground"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-3.5 w-3.5"
                >
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <span>Legal</span>
              </div>

              <h1
                class="text-balance text-4xl font-bold leading-tight tracking-tight text-foreground md:text-6xl lg:text-7xl"
              >
                Privacy Policy
              </h1>

              <p
                class="mx-auto mt-6 max-w-2xl text-pretty text-lg leading-relaxed text-muted-foreground md:text-xl"
              >
                A lightweight, privacy-focused analytics tool designed to respect
                user data. No cross-site tracking, no data selling, no persistent
                cookies.
              </p>

              <p class="mt-8 text-sm text-muted-foreground">
                Effective Date: February 9, 2026
              </p>
            </div>
          </div>
        </section>

        <!-- Main Privacy Content -->
        <section class="section-frame py-32 md:py-48 px-6 md:px-12 bg-white">
          <div class="max-w-4xl mx-auto space-y-12">
            <!-- Section 01: Introduction -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">01</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Introduction</CardTitle
                  >
                </div>
              </CardHeader>
              <CardContent>
                <p class="text-base leading-relaxed text-zinc-600">
                  Welcome to <strong>Witnes</strong> ("we," "us," or "our"). We
                  provide a lightweight, privacy-focused session recording and
                  analytics tool designed to respect user data. We operate with a
                  strict "Privacy by Design" philosophy: we do not track visitors
                  across the web, we do not sell data, and we do not use
                  persistent cookies.
                </p>
                <p class="text-base leading-relaxed text-zinc-600 mt-4">
                  This Privacy Policy explains how we collect, use, and protect
                  data when you visit our website or use our analytics software
                  on your own website.
                </p>
              </CardContent>
            </Card>

            <!-- Section 02: Our Role under GDPR -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">02</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Our Role under GDPR</CardTitle
                  >
                </div>
              </CardHeader>
              <CardContent className="space-y-6">
                <p class="text-base leading-relaxed text-zinc-600">
                  We operate under two distinct capacities depending on how you
                  interact with our services:
                </p>
                <ul class="space-y-3 text-zinc-600">
                  <li class="flex gap-2">
                    <span class="text-[#A68B6A]">•</span>
                    <span
                      ><strong>For Visitors of Customer Websites:</strong> We act
                      as a <strong>Data Processor</strong>. We process data on
                      behalf of our customers (the website owners) to provide
                      them with analytics.</span
                    >
                  </li>
                  <li class="flex gap-2">
                    <span class="text-[#A68B6A]">•</span>
                    <span
                      ><strong>For Our Customers (Account Holders):</strong> We
                      act as a <strong>Data Controller</strong>. We collect your
                      account and billing information to provide the service to
                      you.</span
                    >
                  </li>
                </ul>
              </CardContent>
            </Card>

            <!-- Section 03: Data We Process (The Visitor) -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">03</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Data We Process (Visitors)</CardTitle
                  >
                </div>
              </CardHeader>
              <CardContent className="space-y-8">
                <p class="text-base leading-relaxed text-zinc-600">
                  When the Witnes tracker runs on a website, we collect minimal
                  data to provide performance metrics and session flows.
                </p>
                <div>
                  <h3
                    class="text-base font-bold text-black uppercase tracking-tight mb-4"
                  >
                    a) The "No-Cookie" Approach
                  </h3>
                  <p class="text-base leading-relaxed text-zinc-600 mb-4">
                    We do <strong>not</strong> use cookies, LocalStorage, or
                    persistent identifiers to track visitors. Instead, we use a
                    privacy-preserving hashing mechanism.
                  </p>
                  <ul class="space-y-3 text-zinc-600">
                    <li class="flex gap-2">
                      <span class="text-[#A68B6A]">•</span>
                      <span
                        ><strong>Unique Visitor Identification:</strong> We
                        generate a daily unique ID by creating a cryptographic
                        hash of the visitor's <strong>IP Address</strong> + <strong
                          >User Agent</strong
                        > + <strong>Daily Salt</strong>.</span
                      >
                    </li>
                    <li class="flex gap-2">
                      <span class="text-[#A68B6A]">•</span>
                      <span
                        ><strong>The Daily Salt:</strong> This salt is a random
                        string that rotates automatically every 24 hours. This
                        means a visitor's ID is reset daily, making it impossible
                        to track individual users across multiple days.</span
                      >
                    </li>
                    <li class="flex gap-2">
                      <span class="text-[#A68B6A]">•</span>
                      <span
                        ><strong>No IP Storage:</strong> We do <strong
                          >not</strong
                        > store raw IP addresses in our database. IP addresses
                        are processed in volatile memory solely to generate the
                        hash and are immediately discarded.</span
                      >
                    </li>
                  </ul>
                </div>
                <div>
                  <h3
                    class="text-base font-bold text-black uppercase tracking-tight mb-4"
                  >
                    b) Technical Metrics
                  </h3>
                  <p class="text-base leading-relaxed text-zinc-600 mb-4">
                    We collect the following non-identifiable technical data:
                  </p>
                  <ul class="space-y-3 text-zinc-600">
                    <li class="flex gap-2">
                      <span class="text-[#A68B6A]">•</span>
                      <span
                        ><strong>Performance Vitals:</strong> LCP (Largest
                        Contentful Paint), CLS (Cumulative Layout Shift), TTFB
                        (Time to First Byte).</span
                      >
                    </li>
                    <li class="flex gap-2">
                      <span class="text-[#A68B6A]">•</span>
                      <span
                        ><strong>Device Context:</strong> User Agent, Screen
                        Dimensions, Viewport Size, Connection Type (e.g.,
                        4G/WiFi).</span
                      >
                    </li>
                    <li class="flex gap-2">
                      <span class="text-[#A68B6A]">•</span>
                      <span
                        ><strong>Session Flow:</strong> URLs visited, Referrer
                        (where they came from), and Waterfall latency data.</span
                      >
                    </li>
                  </ul>
                </div>
              </CardContent>
            </Card>

            <!-- Section 04: Data We Collect (The Customer) -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">04</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Data We Collect (Customers)</CardTitle
                  >
                </div>
              </CardHeader>
              <CardContent className="space-y-6">
                <p class="text-base leading-relaxed text-zinc-600">
                  When you sign up for a Witnes account, we collect:
                </p>
                <ul class="space-y-3 text-zinc-600">
                  <li class="flex gap-2">
                    <span class="text-[#A68B6A]">•</span>
                    <span
                      ><strong>Account Information:</strong> Email address,
                      Password (hashed), and Company Name.</span
                    >
                  </li>
                  <li class="flex gap-2">
                    <span class="text-[#A68B6A]">•</span>
                    <span
                      ><strong>Billing Information:</strong> VAT/Tax ID and
                      Billing Address.</span
                    >
                  </li>
                  <li class="flex gap-2">
                    <span class="text-[#A68B6A]">•</span>
                    <span
                      ><strong>Payment Data:</strong> All payments are processed
                      securely by <strong>Stripe</strong>. We do not store or
                      have access to your full credit card number.</span
                    >
                  </li>
                </ul>
              </CardContent>
            </Card>

            <!-- Section 05: Data Retention & Deletion -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">05</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Data Retention & Deletion</CardTitle
                  >
                </div>
              </CardHeader>
              <CardContent className="space-y-6">
                <p class="text-base leading-relaxed text-zinc-600">
                  We believe in "Data Minimalism." We do not hoard data.
                </p>
                <ul class="space-y-3 text-zinc-600">
                  <li class="flex gap-2">
                    <span class="text-[#A68B6A]">•</span>
                    <span
                      ><strong>Visitor Analytics:</strong> All raw event data
                      (metrics, waterfalls, session logs) is strictly retained
                      according to your subscription plan (<strong
                        >7, 14, or 30 days</strong
                      >). After this period, data is automatically and
                      permanently purged from our systems.</span
                    >
                  </li>
                  <li class="flex gap-2">
                    <span class="text-[#A68B6A]">•</span>
                    <span
                      ><strong>Account Data:</strong> If you choose to close your
                      account, we will delete all your personal data (name,
                      email, settings) within <strong>30 days</strong>, except
                      where retention is required by law (e.g., for tax and
                      accounting purposes).</span
                    >
                  </li>
                </ul>
              </CardContent>
            </Card>

            <!-- Section 06: Where We Store Your Data -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">06</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Where We Store Your Data</CardTitle
                  >
                </div>
              </CardHeader>
              <CardContent className="space-y-6">
                <p class="text-base leading-relaxed text-zinc-600">
                  We are committed to keeping data within the European Union.
                </p>
                <ul class="space-y-3 text-zinc-600">
                  <li class="flex gap-2">
                    <span class="text-[#A68B6A]">•</span>
                    <span
                      ><strong>Primary Infrastructure:</strong>
                      <strong>Hetzner Online GmbH</strong> (Germany). All
                      processing and storage of event data occur here.</span
                    >
                  </li>
                  <li class="flex gap-2">
                    <span class="text-[#A68B6A]">•</span>
                    <span
                      ><strong>CDN & Security:</strong>
                      <strong>Cloudflare, Inc.</strong> (Global Edge Network).
                      Used for fast delivery of our script and DDoS
                      protection.</span
                    >
                  </li>
                  <li class="flex gap-2">
                    <span class="text-[#A68B6A]">•</span>
                    <span
                      ><strong>Transactional Email:</strong>
                      <strong>Mailtrap</strong> (Railsware Products, Inc.). Used
                      for sending password resets and system alerts.</span
                    >
                  </li>
                </ul>
              </CardContent>
            </Card>

            <!-- Section 07: Your Rights -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">07</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Your Rights</CardTitle
                  >
                </div>
              </CardHeader>
              <CardContent className="space-y-6">
                <p class="text-base leading-relaxed text-zinc-600">
                  Under the GDPR and similar privacy laws, you have the right to:
                </p>
                <ul class="grid grid-cols-2 gap-4 text-zinc-600 font-medium">
                  <li class="flex gap-2">
                    <span class="text-[#A68B6A]">•</span>
                    <span
                      ><strong>Access</strong> — Request a copy of the personal
                      data we hold about you</span
                    >
                  </li>
                  <li class="flex gap-2">
                    <span class="text-[#A68B6A]">•</span>
                    <span
                      ><strong>Rectification</strong> — Correct any inaccurate
                      data</span
                    >
                  </li>
                  <li class="flex gap-2">
                    <span class="text-[#A68B6A]">•</span>
                    <span
                      ><strong>Erasure</strong> — Request that we delete your
                      data ("Right to be Forgotten")</span
                    >
                  </li>
                  <li class="flex gap-2">
                    <span class="text-[#A68B6A]">•</span>
                    <span
                      ><strong>Portability</strong> — Request your data in a
                      structured, machine-readable format</span
                    >
                  </li>
                </ul>
                <p class="text-base leading-relaxed text-zinc-600">
                  To exercise these rights, please contact us at <strong
                    >support@witnes.io</strong
                  >.
                </p>
              </CardContent>
            </Card>

            <!-- Section 08: Changes to This Policy -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">08</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Changes to This Policy</CardTitle
                  >
                </div>
              </CardHeader>
              <CardContent>
                <p class="text-base leading-relaxed text-zinc-600">
                  We may update this policy to reflect changes in our technology
                  or legal requirements. We will notify active customers of any
                  significant changes via email.
                </p>
              </CardContent>
            </Card>

            <!-- Closing -->
            <Separator className="my-12" />
            <div class="flex flex-col items-center gap-8">
              <Button variant="outline" className="gap-2" asChild client:load>
                <a href="/">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m12 19-7-7 7-7"></path>
                    <path d="M19 12H5"></path>
                  </svg>
                  Back to Home
                </a>
              </Button>
            </div>
          </div>
        </section>
      </main>
      <Footer />
    </div>
  </div>
</PublicLayout>
