---
import PublicLayout from "../layouts/PublicLayout.astro";
import Navbar from "../components/landing/Navbar.astro";
import Footer from "../components/landing/Footer.astro";
import { Button } from "../components/ui/button";
---

<PublicLayout
  title="Terms of Service | Witnes"
  description="Our terms of service. Clear expectations, fair terms, no hidden gotchas."
  canonical="/terms"
>
  <div
    class="min-h-screen flex flex-col selection:bg-[#A68B6A] selection:text-white relative"
  >
    <div class="relative z-10">
      <Navbar />
      <main class="flex-grow">
        <!-- Header Section -->
        <section
          class="relative overflow-hidden pb-20 pt-32 md:pb-32 md:pt-44 border-b"
        >
          <!-- Subtle grid background -->
          <div
            class="pointer-events-none absolute inset-0 opacity-[0.4]"
            style="background-image: linear-gradient(hsl(var(--border)) 1px, transparent 1px), linear-gradient(to right, hsl(var(--border)) 1px, transparent 1px); background-size: 60px 60px;"
          >
          </div>

          <!-- Glow effect -->
          <div
            class="pointer-events-none absolute left-1/2 top-0 -translate-x-1/2 h-[500px] w-[800px] rounded-full bg-muted blur-[120px]"
          >
          </div>

          <div class="relative mx-auto max-w-6xl px-6">
            <div class="mx-auto max-w-3xl text-center">
              <!-- Badge -->
              <div
                class="mb-8 inline-flex items-center gap-2 rounded-full border border-border bg-secondary px-4 py-1.5 text-sm text-foreground"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-3.5 w-3.5"
                >
                  <path
                    d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                  ></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                <span>Legal</span>
              </div>

              <h1
                class="text-balance text-4xl font-bold leading-tight tracking-tight text-foreground md:text-6xl lg:text-7xl"
              >
                Terms of Service
              </h1>

              <p
                class="mx-auto mt-6 max-w-2xl text-pretty text-lg leading-relaxed text-muted-foreground md:text-xl"
              >
                Governing your access to and use of our software, platform, and
                website. By using the Service, you agree to these Terms.
              </p>

              <p class="mt-8 text-sm text-muted-foreground">
                Effective Date: February 9, 2026
              </p>
            </div>
          </div>
        </section>

        <!-- Main Terms Content -->
        <section class="py-16 md:py-24 px-6 bg-background">
          <div class="mx-auto max-w-3xl space-y-20">

            <!-- 01: Acceptance of Terms -->
            <div>
              <div class="flex items-baseline gap-4 mb-4">
                <span class="text-4xl font-extralight text-muted-foreground/40 font-mono">01</span>
                <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Acceptance</p>
              </div>
              <h2 class="text-2xl font-bold tracking-tight text-foreground md:text-3xl">
                Acceptance of Terms
              </h2>
              <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
                By creating an account or using the Witnes analytics script
                ("Service"), you agree to be bound by these Terms of Service.
                If you are entering into this agreement on behalf of a company,
                you represent that you have the authority to bind that entity to
                these terms.
              </p>
            </div>

            <!-- Divider -->
            <div class="h-px bg-border"></div>

            <!-- 02: Description of Service -->
            <div>
              <div class="flex items-baseline gap-4 mb-4">
                <span class="text-4xl font-extralight text-muted-foreground/40 font-mono">02</span>
                <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Service</p>
              </div>
              <h2 class="text-2xl font-bold tracking-tight text-foreground md:text-3xl">
                Description of Service
              </h2>
              <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
                Witnes provides a lightweight, privacy-focused session
                recording and analytics platform. We grant you a limited,
                non-exclusive, non-transferable license to use our tracking
                code on websites you own or control.
              </p>
            </div>

            <!-- Divider -->
            <div class="h-px bg-border"></div>

            <!-- 03: User Obligations & Restrictions -->
            <div>
              <div class="flex items-baseline gap-4 mb-4">
                <span class="text-4xl font-extralight text-muted-foreground/40 font-mono">03</span>
                <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Obligations</p>
              </div>
              <h2 class="text-2xl font-bold tracking-tight text-foreground md:text-3xl">
                User Obligations & Restrictions
              </h2>
              <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
                You agree to use the Service only for lawful purposes. You
                strictly agree <strong class="text-foreground">NOT</strong> to:
              </p>

              <div class="mt-8 space-y-8">
                <div>
                  <h3 class="text-base font-semibold text-foreground uppercase tracking-tight mb-4">
                    a) Prohibited Data (The "Identify" Feature)
                  </h3>
                  <p class="text-base leading-relaxed text-muted-foreground">
                    You must not use the <code
                      class="rounded bg-secondary px-1.5 py-0.5 font-mono text-sm text-foreground"
                      >Witnes.identify()</code
                    > function to collect or store "Personally Identifiable
                    Information" (PII) such as plain-text email addresses, names,
                    phone numbers, or social security numbers. You agree to use
                    only pseudonymous identifiers (e.g., internal Database UUIDs)
                    for this feature.
                  </p>
                </div>
                <div>
                  <h3 class="text-base font-semibold text-foreground uppercase tracking-tight mb-4">
                    b) Abuse & Security
                  </h3>
                  <ul class="space-y-3">
                    <li class="flex gap-3 text-sm text-muted-foreground">
                      <span class="inline-block h-1 w-1 mt-2 rounded-full bg-foreground/40 shrink-0"></span>
                      <span>Reverse engineer, decompile, or disassemble the Witnes tracking code.</span>
                    </li>
                    <li class="flex gap-3 text-sm text-muted-foreground">
                      <span class="inline-block h-1 w-1 mt-2 rounded-full bg-foreground/40 shrink-0"></span>
                      <span>Attempt to probe, scan, or test the vulnerability of our API.</span>
                    </li>
                    <li class="flex gap-3 text-sm text-muted-foreground">
                      <span class="inline-block h-1 w-1 mt-2 rounded-full bg-foreground/40 shrink-0"></span>
                      <span>Use the Service to generate artificial traffic (DDoS) or spam.</span>
                    </li>
                    <li class="flex gap-3 text-sm text-muted-foreground">
                      <span class="inline-block h-1 w-1 mt-2 rounded-full bg-foreground/40 shrink-0"></span>
                      <span>Use the Service on websites that contain illegal content, hate speech, or malware.</span>
                    </li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Divider -->
            <div class="h-px bg-border"></div>

            <!-- 04: Payment & Subscription -->
            <div>
              <div class="flex items-baseline gap-4 mb-4">
                <span class="text-4xl font-extralight text-muted-foreground/40 font-mono">04</span>
                <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Payment</p>
              </div>
              <h2 class="text-2xl font-bold tracking-tight text-foreground md:text-3xl">
                Payment & Subscription
              </h2>

              <ul class="mt-6 space-y-4">
                <li class="flex gap-3 text-muted-foreground">
                  <span class="inline-block h-1 w-1 mt-2.5 rounded-full bg-foreground/40 shrink-0"></span>
                  <span><strong class="text-foreground">Billing:</strong> Services are billed in advance on a monthly or yearly basis via Stripe.</span>
                </li>
                <li class="flex gap-3 text-muted-foreground">
                  <span class="inline-block h-1 w-1 mt-2.5 rounded-full bg-foreground/40 shrink-0"></span>
                  <span><strong class="text-foreground">Refunds:</strong> You may cancel your subscription at any time. Refunds are provided solely at our discretion, typically only in cases of extended service failure.</span>
                </li>
                <li class="flex gap-3 text-muted-foreground">
                  <span class="inline-block h-1 w-1 mt-2.5 rounded-full bg-foreground/40 shrink-0"></span>
                  <span><strong class="text-foreground">Plan Limits:</strong> Data retention (7, 14, or 30 days) is strictly enforced based on your selected plan. We reserve the right to throttle or limit data ingestion if you significantly exceed the usage limits of your tier.</span>
                </li>
              </ul>
            </div>

            <!-- Divider -->
            <div class="h-px bg-border"></div>

            <!-- 05: Data Ownership -->
            <div>
              <div class="flex items-baseline gap-4 mb-4">
                <span class="text-4xl font-extralight text-muted-foreground/40 font-mono">05</span>
                <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Ownership</p>
              </div>
              <h2 class="text-2xl font-bold tracking-tight text-foreground md:text-3xl">
                Data Ownership
              </h2>

              <ul class="mt-6 space-y-4">
                <li class="flex gap-3 text-muted-foreground">
                  <span class="inline-block h-1 w-1 mt-2.5 rounded-full bg-foreground/40 shrink-0"></span>
                  <span><strong class="text-foreground">Your Data:</strong> You retain all rights and ownership of the data you collect using Witnes. We do not claim ownership of your user data.</span>
                </li>
                <li class="flex gap-3 text-muted-foreground">
                  <span class="inline-block h-1 w-1 mt-2.5 rounded-full bg-foreground/40 shrink-0"></span>
                  <span><strong class="text-foreground">License to Process:</strong> You grant us a worldwide, royalty-free license to access, process, and store your data solely for the purpose of providing the Service to you.</span>
                </li>
              </ul>
            </div>

            <!-- Divider -->
            <div class="h-px bg-border"></div>

            <!-- 06: Limitation of Liability -->
            <div>
              <div class="flex items-baseline gap-4 mb-4">
                <span class="text-4xl font-extralight text-muted-foreground/40 font-mono">06</span>
                <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Liability</p>
              </div>
              <h2 class="text-2xl font-bold tracking-tight text-foreground md:text-3xl">
                Limitation of Liability
              </h2>
              <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
                To the maximum extent permitted by law, Witnes shall not be
                liable for any indirect, incidental, special, consequential, or
                punitive damages, including without limitation, loss of
                profits, data, use, goodwill, or other intangible losses.
              </p>
              <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
                <strong class="text-foreground">Service Credits:</strong> In the event of a Service
                interruption caused by our systems, your sole remedy shall be a
                credit to your account equal to the pro-rated charges for the
                period of the downtime.
              </p>
            </div>

            <!-- Divider -->
            <div class="h-px bg-border"></div>

            <!-- 07: Termination -->
            <div>
              <div class="flex items-baseline gap-4 mb-4">
                <span class="text-4xl font-extralight text-muted-foreground/40 font-mono">07</span>
                <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Termination</p>
              </div>
              <h2 class="text-2xl font-bold tracking-tight text-foreground md:text-3xl">
                Termination
              </h2>
              <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
                We may suspend or terminate your access to the Service
                immediately, without prior notice, if you breach these Terms
                (e.g., by collecting prohibited PII or attacking our
                infrastructure). Upon termination, your right to use the
                Service will immediately cease, and your data may be deleted
                according to our retention policies.
              </p>
            </div>

            <!-- Divider -->
            <div class="h-px bg-border"></div>

            <!-- 08: Governing Law -->
            <div>
              <div class="flex items-baseline gap-4 mb-4">
                <span class="text-4xl font-extralight text-muted-foreground/40 font-mono">08</span>
                <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Jurisdiction</p>
              </div>
              <h2 class="text-2xl font-bold tracking-tight text-foreground md:text-3xl">
                Governing Law
              </h2>
              <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
                These Terms shall be governed by and construed in accordance
                with the laws of <strong class="text-foreground">Greece</strong> and applicable <strong class="text-foreground">EU law</strong>,
                without regard to its conflict of law provisions. Any
                dispute shall fall under the exclusive jurisdiction of the
                courts of <strong class="text-foreground">Thessaloniki, Greece</strong>.
              </p>
            </div>

            <!-- Divider -->
            <div class="h-px bg-border"></div>

            <!-- Closing -->
            <div class="flex flex-col items-center gap-4">
              <p class="text-base text-muted-foreground">
                For any questions regarding these Terms, please contact us at
                <strong class="text-foreground">support@witnes.io</strong>.
              </p>
              <Button variant="outline" className="gap-2" asChild client:load>
                <a href="/">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m12 19-7-7 7-7"></path>
                    <path d="M19 12H5"></path>
                  </svg>
                  Back to Home
                </a>
              </Button>
            </div>
          </div>
        </section>
      </main>
      <Footer />
    </div>
  </div>
</PublicLayout>
