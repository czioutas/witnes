---
import PublicLayout from "../layouts/PublicLayout.astro";
import Navbar from "../components/landing/Navbar.astro";
import Footer from "../components/landing/Footer.astro";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "../components/ui/card";
import { Badge } from "../components/ui/badge";
import { Button } from "../components/ui/button";
import { Separator } from "../components/ui/separator";
---

<PublicLayout
  title="Terms of Service | Witnes"
  description="Our terms of service. Clear expectations, fair terms, no hidden gotchas."
  canonical="/terms"
>
  <div
    class="min-h-screen flex flex-col selection:bg-[#A68B6A] selection:text-white relative"
  >
    <div class="relative z-10">
      <Navbar />
      <main class="flex-grow">
        <!-- Header Section -->
        <section
          class="relative overflow-hidden pb-20 pt-32 md:pb-32 md:pt-44 border-b"
        >
          <!-- Subtle grid background -->
          <div
            class="pointer-events-none absolute inset-0 opacity-[0.4]"
            style="background-image: linear-gradient(hsl(var(--border)) 1px, transparent 1px), linear-gradient(to right, hsl(var(--border)) 1px, transparent 1px); background-size: 60px 60px;"
          >
          </div>

          <!-- Glow effect -->
          <div
            class="pointer-events-none absolute left-1/2 top-0 -translate-x-1/2 h-[500px] w-[800px] rounded-full bg-muted blur-[120px]"
          >
          </div>

          <div class="relative mx-auto max-w-6xl px-6">
            <div class="mx-auto max-w-3xl text-center">
              <!-- Badge -->
              <div
                class="mb-8 inline-flex items-center gap-2 rounded-full border border-border bg-secondary px-4 py-1.5 text-sm text-foreground"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-3.5 w-3.5"
                >
                  <path
                    d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                  ></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                <span>Legal</span>
              </div>

              <h1
                class="text-balance text-4xl font-bold leading-tight tracking-tight text-foreground md:text-6xl lg:text-7xl"
              >
                Terms of Service
              </h1>

              <p
                class="mx-auto mt-6 max-w-2xl text-pretty text-lg leading-relaxed text-muted-foreground md:text-xl"
              >
                Governing your access to and use of our software, platform, and
                website. By using the Service, you agree to these Terms.
              </p>

              <p class="mt-8 text-sm text-muted-foreground">
                Last updated: January 2026
              </p>
            </div>
          </div>
        </section>

        <!-- Main Terms Content -->
        <section class="section-frame py-32 md:py-48 px-6 md:px-12 bg-white">
          <div class="max-w-4xl mx-auto space-y-12">
            <!-- Section 01: About the Service -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">01</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >About the Service</CardTitle
                  >
                </div>
              </CardHeader>
              <CardContent>
                <p class="text-base leading-relaxed text-zinc-600">
                  Witnes provides <strong
                    >analytical and informational estimates</strong
                  > only. It does not constitute certification, verification, or assurance
                  under ISO 14067, GHG Protocol, or any other standard.
                </p>
              </CardContent>
            </Card>

            <!-- Section 02: Eligibility -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">02</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Eligibility</CardTitle
                  >
                </div>
              </CardHeader>
              <CardContent>
                <p class="text-base leading-relaxed text-zinc-600">
                  You must be at least 18 years old and legally able to enter
                  into a binding agreement. If using the service on behalf of an
                  organization, you confirm you are authorized to bind that
                  entity.
                </p>
              </CardContent>
            </Card>

            <!-- Section 03: Accounts -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">03</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Accounts</CardTitle
                  >
                </div>
              </CardHeader>
              <CardContent>
                <p class="text-base leading-relaxed text-zinc-600">
                  You are responsible for your account credentials and all
                  activity under your account. We reserve the right to suspend
                  or terminate accounts that violate these Terms.
                </p>
              </CardContent>
            </Card>

            <!-- Section 04: Acceptable Use -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">04</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Acceptable Use</CardTitle
                  >
                </div>
              </CardHeader>
              <CardContent>
                <p class="text-base leading-relaxed text-zinc-600 mb-4">
                  You agree not to:
                </p>
                <ul class="space-y-3 text-zinc-600">
                  <li class="flex gap-2">
                    <span class="text-[#A68B6A]">•</span>
                    <span
                      >Copy, modify, or redistribute the Service or its content</span
                    >
                  </li>
                  <li class="flex gap-2">
                    <span class="text-[#A68B6A]">•</span>
                    <span
                      >Reverse-engineer or attempt to access the source code</span
                    >
                  </li>
                  <li class="flex gap-2">
                    <span class="text-[#A68B6A]">•</span>
                    <span>Misrepresent results as verified or certified</span>
                  </li>
                  <li class="flex gap-2">
                    <span class="text-[#A68B6A]">•</span>
                    <span>Upload unlawful or infringing data</span>
                  </li>
                </ul>
              </CardContent>
            </Card>

            <!-- Section 05: Payment -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">05</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Payment</CardTitle
                  >
                </div>
              </CardHeader>
              <CardContent>
                <p class="text-base leading-relaxed text-zinc-600">
                  Paid plans renew automatically. All prices are in EUR and may
                  change with notice. Fees are non-refundable except where
                  required by law.
                </p>
              </CardContent>
            </Card>

            <!-- Section 06: Intellectual Property -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">06</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Intellectual Property</CardTitle
                  >
                </div>
              </CardHeader>
              <CardContent>
                <p class="text-base leading-relaxed text-zinc-600">
                  All software, designs, databases, and documentation are the
                  property of Witnes or its licensors.
                </p>
              </CardContent>
            </Card>

            <!-- Section 07: Automated Features -->
            <Card className="border-zinc-200 bg-[#F9F9F7]">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">07</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Automated Features</CardTitle
                  >
                </div>
                <CardDescription
                  className="text-base font-bold text-black uppercase tracking-tight mt-4"
                >
                  AI Extraction Disclaimer
                </CardDescription>
              </CardHeader>
              <CardContent>
                <p class="text-base leading-relaxed text-zinc-600">
                  AI-powered data extraction features are provided <strong
                    >"as is"</strong
                  >. <strong>You are solely responsible</strong> for reviewing, verifying,
                  and correcting all automatically processed data. We are <strong
                    >not liable</strong
                  > for any errors resulting from reliance on extracted data.
                </p>
              </CardContent>
            </Card>

            <!-- Section 08: Liability -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">08</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Liability</CardTitle
                  >
                </div>
              </CardHeader>
              <CardContent>
                <p class="text-base leading-relaxed text-zinc-600">
                  The Service is provided "as is". Our total liability shall not
                  exceed the amount you paid in the preceding 12 months. We are
                  not liable for indirect or consequential damages.
                </p>
              </CardContent>
            </Card>

            <!-- Section 09: Jurisdiction -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">09</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Jurisdiction</CardTitle
                  >
                </div>
              </CardHeader>
              <CardContent>
                <p class="text-base leading-relaxed text-zinc-600">
                  These Terms are governed by the laws of <strong>Greece</strong
                  > and applicable <strong>EU law</strong>. Any dispute shall
                  fall under the exclusive jurisdiction of the courts of <strong
                    >Thessaloniki, Greece</strong
                  >.
                </p>
              </CardContent>
            </Card>

            <!-- Closing -->
            <Separator className="my-12" />
            <div class="flex flex-col items-center gap-8">
              <Button variant="outline" className="gap-2" asChild client:load>
                <a href="/">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m12 19-7-7 7-7"></path>
                    <path d="M19 12H5"></path>
                  </svg>
                  Back to Home
                </a>
              </Button>
            </div>
          </div>
        </section>
      </main>
      <Footer />
    </div>
  </div>
</PublicLayout>
