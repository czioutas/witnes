---
import PublicLayout from "../layouts/PublicLayout.astro";
import Navbar from "../components/landing/Navbar.astro";
import Footer from "../components/landing/Footer.astro";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "../components/ui/card";
import { Badge } from "../components/ui/badge";
import { Button } from "../components/ui/button";
import { Separator } from "../components/ui/separator";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "../components/ui/table";
---

<PublicLayout
  title="Integration Guide | Witnes"
  description="Learn how to integrate Witnes tracking into your application. Simple setup, powerful insights."
  canonical="/integration"
>
  <div
    class="min-h-screen flex flex-col selection:bg-[#A68B6A] selection:text-white relative"
  >
    <div class="relative z-10">
      <Navbar />
      <main class="flex-grow">
        <!-- Header Section -->
        <section
          class="relative overflow-hidden pb-20 pt-32 md:pb-32 md:pt-44 border-b"
        >
          <!-- Subtle grid background -->
          <div
            class="pointer-events-none absolute inset-0 opacity-[0.4]"
            style="background-image: linear-gradient(hsl(var(--border)) 1px, transparent 1px), linear-gradient(to right, hsl(var(--border)) 1px, transparent 1px); background-size: 60px 60px;"
          >
          </div>

          <!-- Glow effect -->
          <div
            class="pointer-events-none absolute left-1/2 top-0 -translate-x-1/2 h-[500px] w-[800px] rounded-full bg-muted blur-[120px]"
          >
          </div>

          <div class="relative mx-auto max-w-6xl px-6">
            <div class="mx-auto max-w-3xl text-center">
              <!-- Badge -->
              <div
                class="mb-8 inline-flex items-center gap-2 rounded-full border border-border bg-secondary px-4 py-1.5 text-sm text-foreground"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-3.5 w-3.5"
                >
                  <path
                    d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"
                  ></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
                <span>For Developers</span>
              </div>

              <h1
                class="text-balance text-4xl font-bold leading-tight tracking-tight text-foreground md:text-6xl lg:text-7xl"
              >
                Integration Guide
              </h1>

              <p
                class="mx-auto mt-6 max-w-2xl text-pretty text-lg leading-relaxed text-muted-foreground md:text-xl"
              >
                Add our lightweight tracker to your frontend and start capturing
                user behavior receipts for your Customer Success team.
              </p>

              <p class="mt-8 text-sm text-muted-foreground">
                Two lines of code. Zero config. Zero performance impact.
              </p>
            </div>
          </div>
        </section>

        <!-- Main Integration Content -->
        <section class="py-16 md:py-24 px-6 bg-background">
          <div class="container max-w-4xl mx-auto space-y-12">
            <!-- Section 01: Quick Start -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">01</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Quick Start (Standard Setup)</CardTitle
                  >
                </div>
                <CardDescription className="text-base text-zinc-600 mt-4">
                  Copy and paste this snippet into the <code
                    class="text-sm bg-zinc-100 px-2 py-1 rounded"
                    >&lt;head&gt;</code
                  > of your website. This is ideal for traditional web applications
                  where the user identity is known at the time of page render.
                </CardDescription>
              </CardHeader>
              <CardContent>
                <div class="rounded-lg bg-zinc-50 p-6 border border-zinc-200">
                  <pre
                    class="overflow-x-auto text-sm"><code class="language-html">&lt;script&gt;
  window.witnesConfig = &#123;
    projectKey: 'YOUR_PROJECT_KEY',
  &#125;;
&lt;/script&gt;
&lt;script src="https://cdn-witnes.ziou.xyz/w.min.js" async&gt;&lt;/script&gt;</code></pre>
                </div>
              </CardContent>
            </Card>

            <!-- Section 02: Dynamic Setup -->
            <Card className="border-zinc-200 bg-[#F9F9F7]">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">02</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Dynamic Setup (Single Page Apps)</CardTitle
                  >
                </div>
                <CardDescription className="text-base text-zinc-600 mt-4">
                  If you are using a framework like <strong>React</strong>, <strong
                    >Vue</strong
                  >, or <strong>Next.js</strong>, you might not know the User ID
                  until after the page has loaded and the user has logged in.
                </CardDescription>
              </CardHeader>
              <CardContent className="space-y-8">
                <div>
                  <h3 class="text-base font-semibold text-black mb-4">
                    Step A: Initialize with the Project Key
                  </h3>
                  <p class="text-sm text-zinc-600 mb-4">
                    Add this to your main HTML file:
                  </p>
                  <div class="rounded-lg bg-white p-6 border border-zinc-200">
                    <pre
                      class="overflow-x-auto text-sm"><code class="language-html">&lt;script&gt;
  window.witnesConfig = &#123; projectKey: 'YOUR_PROJECT_KEY' &#125;;
&lt;/script&gt;
&lt;script src="https://cdn-witnes.ziou.xyz/w.min.js" async&gt;&lt;/script&gt;</code></pre>
                  </div>
                </div>

                <Separator />

                <div>
                  <h3 class="text-base font-semibold text-black mb-4">
                    Step B: Identify the User
                  </h3>
                  <p class="text-sm text-zinc-600 mb-4">
                    Call the <code class="text-sm bg-zinc-100 px-2 py-1 rounded"
                      >identify</code
                    > method as soon as your authentication is complete. Witnes will
                    automatically begin tracking events once an ID is provided.
                  </p>

                  <!-- Privacy Warning -->
                  <div class="rounded-lg bg-amber-50 border border-amber-200 p-4 mb-4">
                    <div class="flex gap-3">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-600 mt-0.5 flex-shrink-0">
                        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
                        <path d="M12 9v4"></path>
                        <path d="M12 17h.01"></path>
                      </svg>
                      <div>
                        <p class="text-sm font-semibold text-amber-800 mb-1">Do not use personally identifiable information as the User ID</p>
                        <p class="text-sm text-amber-700">
                          Never pass emails, full names, phone numbers, or any other personal data as the User ID. Use an opaque internal identifier (e.g. a database ID or UUID) instead. If you choose to send identifiable data, <strong>you are solely responsible</strong> for any privacy or regulatory violations that may result (GDPR, CCPA, etc.). See our <a href="/privacy" class="underline font-medium hover:text-amber-900">Privacy Policy</a> for details.
                        </p>
                      </div>
                    </div>
                  </div>

                  <div class="rounded-lg bg-white p-6 border border-zinc-200">
                    <pre
                      class="overflow-x-auto text-sm"><code class="language-javascript">// Call this after your login logic
// Use an opaque ID — never use emails or personal data
if (window.Witnes) &#123;
    window.Witnes.identify("customer_id_99");
&#125; else &#123;
    window.witnesConfig.userId = "customer_id_99";
&#125;</code></pre>
                  </div>
                </div>
              </CardContent>
            </Card>

            <!-- Section 03: Billing -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">03</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >How Billing Works</CardTitle
                  >
                </div>
                <CardDescription className="text-base text-zinc-600 mt-4">
                  Witnes calculates usage based on <strong>Units</strong>.
                </CardDescription>
              </CardHeader>
              <CardContent className="space-y-6">
                <div class="bg-zinc-50 p-6 rounded-lg border border-zinc-200">
                  <p class="text-2xl font-bold text-black mb-2">
                    1 Unit = 50 Events
                  </p>
                </div>

                <div>
                  <h3 class="text-base font-semibold text-black mb-4">
                    Tracked Events:
                  </h3>
                  <ul class="space-y-3 text-zinc-600">
                    <li class="flex gap-3">
                      <span class="text-[#A68B6A] font-mono text-sm">•</span>
                      <div>
                        <strong class="text-black">LOAD:</strong> Triggered when a
                        page is first opened.
                      </div>
                    </li>
                    <li class="flex gap-3">
                      <span class="text-[#A68B6A] font-mono text-sm">•</span>
                      <div>
                        <strong class="text-black">SPA_NAV:</strong> Triggered when
                        the URL changes (even without a page reload).
                      </div>
                    </li>
                  </ul>
                </div>
              </CardContent>
            </Card>

            <!-- Section 04: Browser Coverage -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">04</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Browser Coverage</CardTitle
                  >
                </div>
                <CardDescription className="text-base text-zinc-600 mt-4">
                  We support all modern browsers. Some advanced metrics are
                  subject to browser API availability.
                </CardDescription>
              </CardHeader>
              <CardContent>
                <Table>
                  <TableHeader>
                    <TableRow>
                      <TableHead>Feature</TableHead>
                      <TableHead>Chrome 131+</TableHead>
                      <TableHead>Edge 131+</TableHead>
                      <TableHead>Safari 18.5+</TableHead>
                      <TableHead>Firefox 133+</TableHead>
                      <TableHead>Notes</TableHead>
                    </TableRow>
                  </TableHeader>
                  <TableBody>
                    <TableRow>
                      <TableCell className="font-medium"
                        >Session Tracking</TableCell
                      >
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>⚠️ Theory</TableCell>
                      <TableCell>sessionStorage universal</TableCell>
                    </TableRow>
                    <TableRow>
                      <TableCell className="font-medium">LCP</TableCell>
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>⚠️ Theory</TableCell>
                      <TableCell>Safari 18.2+ (Dec 2024)</TableCell>
                    </TableRow>
                    <TableRow>
                      <TableCell className="font-medium">CLS</TableCell>
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>⚠️ Theory</TableCell>
                      <TableCell>-</TableCell>
                    </TableRow>
                    <TableRow>
                      <TableCell className="font-medium">FCP</TableCell>
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>⚠️ Theory</TableCell>
                      <TableCell>-</TableCell>
                    </TableRow>
                    <TableRow>
                      <TableCell className="font-medium">Long Tasks</TableCell>
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>❌ Never</TableCell>
                      <TableCell>⚠️ Theory</TableCell>
                      <TableCell>Safari lacks longtask API</TableCell>
                    </TableRow>
                    <TableRow>
                      <TableCell className="font-medium"
                        >Resource Timing</TableCell
                      >
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>⚠️ Partial</TableCell>
                      <TableCell>⚠️ Theory</TableCell>
                      <TableCell>Safari: ~60% missing protocol</TableCell>
                    </TableRow>
                    <TableRow>
                      <TableCell className="font-medium">Network Info</TableCell
                      >
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>❌ Never</TableCell>
                      <TableCell>❌ Never</TableCell>
                      <TableCell>Chromium exclusive</TableCell>
                    </TableRow>
                    <TableRow>
                      <TableCell className="font-medium">sendBeacon</TableCell>
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>✅ Tested</TableCell>
                      <TableCell>⚠️ Theory</TableCell>
                      <TableCell>fetch keepalive fallback</TableCell>
                    </TableRow>
                  </TableBody>
                </Table>
                <div class="mt-4 space-y-1 text-xs text-muted-foreground">
                  <p>• Tested Versions: Chrome 131, Edge 131, Safari 18.5</p>
                  <p>• Theory: Firefox 133+ per MDN compatibility data</p>
                  <p>
                    • Safari Notes: LCP support added in Safari 18.2/macOS 15.2
                    (December 2024)
                  </p>
                </div>
              </CardContent>
            </Card>

            <!-- Section 05: Technical Details -->
            <Card className="border-zinc-200">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">05</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Technical Details</CardTitle
                  >
                </div>
              </CardHeader>
              <CardContent className="space-y-8">
                <div>
                  <h3 class="text-base font-semibold text-black mb-4">
                    Performance
                  </h3>
                  <ul class="space-y-3 text-zinc-600">
                    <li class="flex gap-3">
                      <span class="text-[#A68B6A]">•</span>
                      <div>
                        <strong class="text-black">Zero Blocking:</strong> Our script
                        uses the <code
                          class="text-sm bg-zinc-100 px-2 py-1 rounded"
                          >async</code
                        > attribute and <code
                          class="text-sm bg-zinc-100 px-2 py-1 rounded"
                          >navigator.sendBeacon</code
                        >. It will never slow down your page load or delay your
                        users.
                      </div>
                    </li>
                    <li class="flex gap-3">
                      <span class="text-[#A68B6A]">•</span>
                      <div>
                        <strong class="text-black">Lightweight:</strong> The library
                        is &lt; 1KB gzipped.
                      </div>
                    </li>
                  </ul>
                </div>

                <Separator />

                <div>
                  <h3 class="text-base font-semibold text-black mb-4">
                    Security & Privacy
                  </h3>
                  <ul class="space-y-3 text-zinc-600">
                    <li class="flex gap-3">
                      <span class="text-[#A68B6A]">•</span>
                      <div>
                        <strong class="text-black">Project Key:</strong> Used to route
                        data to your specific dashboard.
                      </div>
                    </li>
                    <li class="flex gap-3">
                      <span class="text-[#A68B6A]">•</span>
                      <div>
                        <strong class="text-black">User ID:</strong> We require a
                        User ID so your CS agents can search for specific sessions
                        when a ticket is filed. You <strong>must</strong> use a non-identifiable
                        internal ID (e.g. a database ID or UUID). Do not send emails,
                        names, or any personally identifiable information. If you choose
                        to pass identifiable data, you bear full responsibility for any
                        resulting privacy violations.
                      </div>
                    </li>
                  </ul>
                </div>
              </CardContent>
            </Card>

            <!-- Section 06: Troubleshooting -->
            <Card className="border-zinc-200 bg-[#F9F9F7]">
              <CardHeader>
                <div class="flex items-center gap-3 mb-2">
                  <Badge variant="outline" className="text-sm">06</Badge>
                  <CardTitle className="text-xl uppercase tracking-widest"
                    >Troubleshooting</CardTitle
                  >
                </div>
                <CardDescription
                  className="text-base font-semibold text-black mt-4"
                >
                  Events not appearing?
                </CardDescription>
              </CardHeader>
              <CardContent>
                <ul class="space-y-3 text-zinc-600">
                  <li class="flex gap-3">
                    <span class="text-[#A68B6A]">•</span>
                    <div>
                      Check that the <code
                        class="text-sm bg-zinc-100 px-2 py-1 rounded"
                        >projectKey</code
                      > matches your dashboard exactly.
                    </div>
                  </li>
                  <li class="flex gap-3">
                    <span class="text-[#A68B6A]">•</span>
                    <div>
                      Ensure <code class="text-sm bg-zinc-100 px-2 py-1 rounded"
                        >Witnes.identify()</code
                      > is being called with a non-null string.
                    </div>
                  </li>
                  <li class="flex gap-3">
                    <span class="text-[#A68B6A]">•</span>
                    <div>
                      Open your browser console and verify that requests to <code
                        class="text-sm bg-zinc-100 px-2 py-1 rounded"
                        >api.witnes.io/ingest</code
                      > are returning <strong>202 Accepted</strong>.
                    </div>
                  </li>
                </ul>
              </CardContent>
            </Card>

            <!-- Closing -->
            <Separator className="my-12" />
            <div class="flex flex-col items-center gap-8">
              <Button variant="outline" className="gap-2" asChild client:load>
                <a href="/">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m12 19-7-7 7-7"></path>
                    <path d="M19 12H5"></path>
                  </svg>
                  Back to Home
                </a>
              </Button>
            </div>
          </div>
        </section>
      </main>
      <Footer />
    </div>
  </div>
</PublicLayout>
