---
import PublicLayout from "../layouts/PublicLayout.astro";
import Navbar from "../components/landing/Navbar.astro";
import Footer from "../components/landing/Footer.astro";
import { Button } from "../components/ui/button";
---

<PublicLayout
  title="Integration Guide | Witnes"
  description="Learn how to integrate Witnes tracking into your application. Simple setup, powerful insights."
  canonical="/integration"
>
  <div
    class="min-h-screen flex flex-col selection:bg-[#A68B6A] selection:text-white relative"
  >
    <div class="relative z-10">
      <Navbar />
      <main class="flex-grow">
        <!-- Header Section -->
        <section
          class="relative overflow-hidden pb-20 pt-32 md:pb-32 md:pt-44 border-b"
        >
          <!-- Subtle grid background -->
          <div
            class="pointer-events-none absolute inset-0 opacity-[0.4]"
            style="background-image: linear-gradient(hsl(var(--border)) 1px, transparent 1px), linear-gradient(to right, hsl(var(--border)) 1px, transparent 1px); background-size: 60px 60px;"
          >
          </div>

          <!-- Glow effect -->
          <div
            class="pointer-events-none absolute left-1/2 top-0 -translate-x-1/2 h-[500px] w-[800px] rounded-full bg-muted blur-[120px]"
          >
          </div>

          <div class="relative mx-auto max-w-6xl px-6">
            <div class="mx-auto max-w-3xl text-center">
              <!-- Badge -->
              <div
                class="mb-8 inline-flex items-center gap-2 rounded-full border border-border bg-secondary px-4 py-1.5 text-sm text-foreground"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-3.5 w-3.5"
                >
                  <path
                    d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"
                  ></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
                <span>For Developers</span>
              </div>

              <h1
                class="text-balance text-4xl font-bold leading-tight tracking-tight text-foreground md:text-6xl lg:text-7xl"
              >
                Integration Guide
              </h1>

              <p
                class="mx-auto mt-6 max-w-2xl text-pretty text-lg leading-relaxed text-muted-foreground md:text-xl"
              >
                Add our lightweight tracker to your frontend and start capturing
                user behavior receipts for your Customer Success team.
              </p>

              <p class="mt-8 text-sm text-muted-foreground">
                Two lines of code. Zero config. Zero performance impact.
              </p>
            </div>
          </div>
        </section>

        <!-- Main Integration Content -->
        <section class="py-16 md:py-24 px-6 bg-background">
          <div class="mx-auto max-w-3xl space-y-20">
            <!-- 01: Setup -->
            <div>
              <div class="flex items-baseline gap-4 mb-4">
                <span class="text-4xl font-extralight text-muted-foreground/40 font-mono">01</span>
                <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Setup</p>
              </div>
              <h2 class="text-2xl font-bold tracking-tight text-foreground md:text-3xl">
                Add the Snippet
              </h2>
              <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
                Add this to the{" "}
                <code class="rounded bg-secondary px-2 py-0.5 font-mono text-sm text-foreground">&lt;head&gt;</code>{" "}
                of your website. If you already know the user's ID at render time, pass it directly in the config. Otherwise, just set the{" "}
                <code class="rounded bg-secondary px-2 py-0.5 font-mono text-sm text-foreground">projectKey</code>{" "}
                and identify later.
              </p>

              <!-- Code block: basic setup with optional userId -->
              <div class="mt-8 rounded-xl border border-border bg-zinc-950 overflow-hidden code-block">
                <div class="flex items-center justify-between border-b border-zinc-800 px-4 py-3">
                  <div class="flex items-center gap-2">
                    <div class="flex items-center gap-1.5">
                      <div class="h-2.5 w-2.5 rounded-full bg-zinc-700"></div>
                      <div class="h-2.5 w-2.5 rounded-full bg-zinc-700"></div>
                      <div class="h-2.5 w-2.5 rounded-full bg-zinc-700"></div>
                    </div>
                    <span class="ml-3 text-xs font-medium text-zinc-400">index.html</span>
                  </div>
                  <button class="copy-btn text-zinc-500 hover:text-zinc-300 transition-colors" aria-label="Copy code">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
                  </button>
                </div>
                <div class="p-5">
                  <pre class="overflow-x-auto text-sm leading-7"><code><span class="text-red-400">&lt;script&gt;</span>
  <span class="text-zinc-300">window.</span><span class="text-blue-400">witnesConfig</span> <span class="text-zinc-500">=</span> <span class="text-zinc-300">&#123;</span>
    <span class="text-zinc-300">projectKey:</span> <span class="text-emerald-400">'YOUR_PROJECT_KEY'</span><span class="text-zinc-300">,</span>
    <span class="text-zinc-300">userId:</span>     <span class="text-emerald-400">'user_4821'</span><span class="text-zinc-300">,</span>  <span class="text-zinc-500 italic">// optional — pass it if you know it</span>
  <span class="text-zinc-300">&#125;;</span>
<span class="text-red-400">&lt;/script&gt;</span>
<span class="text-red-400">&lt;script</span> <span class="text-blue-400">src</span><span class="text-zinc-500">=</span><span class="text-emerald-400">"https://cdn-witnes.ziou.xyz/w.min.js"</span> <span class="text-blue-400">async</span><span class="text-red-400">&gt;&lt;/script&gt;</span></code></pre>
                </div>
              </div>
            </div>

            <!-- Divider -->
            <div class="h-px bg-border"></div>

            <!-- 02: Identifying Users -->
            <div>
              <div class="flex items-baseline gap-4 mb-4">
                <span class="text-4xl font-extralight text-muted-foreground/40 font-mono">02</span>
                <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Identification</p>
              </div>
              <h2 class="text-2xl font-bold tracking-tight text-foreground md:text-3xl">
                Identifying Users
              </h2>
              <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
                There are three ways to associate sessions with a user. Pick whichever fits your app.
              </p>

              <!-- Privacy Warning -->
              <div class="mt-8 mb-8 rounded-lg border-l-4 border-amber-500 bg-amber-50/50 px-5 py-4">
                <p class="text-sm font-semibold text-foreground mb-1">Do not use personally identifiable information as the User ID</p>
                <p class="text-sm text-muted-foreground leading-relaxed">
                  Never pass emails, full names, or phone numbers. Use an opaque internal identifier (e.g. a database ID or UUID). If you choose to send identifiable data, <strong class="text-foreground">you are solely responsible</strong> for any privacy violations (GDPR, CCPA, etc.). See our <a href="/privacy" class="underline font-medium text-foreground hover:text-foreground/80">Privacy Policy</a>.
                </p>
              </div>

              <!-- Option A: Static -->
              <div class="space-y-10">
                <div>
                  <div class="flex items-center gap-3 mb-3">
                    <span class="flex h-6 w-6 items-center justify-center rounded-full bg-secondary text-xs font-semibold text-foreground">A</span>
                    <h3 class="text-base font-semibold text-foreground">Static — userId known at render time</h3>
                  </div>
                  <p class="text-sm text-muted-foreground mb-4 pl-9">
                    Pass{" "}
                    <code class="rounded bg-secondary px-2 py-0.5 font-mono text-sm text-foreground">userId</code>{" "}
                    directly in the config. The tracker picks it up immediately.
                  </p>
                  <div class="rounded-xl border border-border bg-zinc-950 overflow-hidden code-block">
                    <div class="flex items-center justify-between border-b border-zinc-800 px-4 py-3">
                      <div class="flex items-center gap-2">
                        <div class="flex items-center gap-1.5">
                          <div class="h-2.5 w-2.5 rounded-full bg-zinc-700"></div>
                          <div class="h-2.5 w-2.5 rounded-full bg-zinc-700"></div>
                          <div class="h-2.5 w-2.5 rounded-full bg-zinc-700"></div>
                        </div>
                        <span class="ml-3 text-xs font-medium text-zinc-400">index.html</span>
                      </div>
                      <button class="copy-btn text-zinc-500 hover:text-zinc-300 transition-colors" aria-label="Copy code">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
                      </button>
                    </div>
                    <div class="p-5">
                      <pre class="overflow-x-auto text-sm leading-7"><code><span class="text-zinc-300">window.</span><span class="text-blue-400">witnesConfig</span> <span class="text-zinc-500">=</span> <span class="text-zinc-300">&#123;</span>
  <span class="text-zinc-300">projectKey:</span> <span class="text-emerald-400">'YOUR_PROJECT_KEY'</span><span class="text-zinc-300">,</span>
  <span class="text-zinc-300">userId:</span>     <span class="text-emerald-400">'user_4821'</span><span class="text-zinc-300">,</span>
<span class="text-zinc-300">&#125;;</span></code></pre>
                    </div>
                  </div>
                </div>

                <!-- Option B: Dynamic -->
                <div>
                  <div class="flex items-center gap-3 mb-3">
                    <span class="flex h-6 w-6 items-center justify-center rounded-full bg-secondary text-xs font-semibold text-foreground">B</span>
                    <h3 class="text-base font-semibold text-foreground">Dynamic — userId known after login</h3>
                  </div>
                  <p class="text-sm text-muted-foreground mb-4 pl-9">
                    For SPAs using <strong class="text-foreground">React</strong>, <strong class="text-foreground">Vue</strong>, <strong class="text-foreground">Next.js</strong>, etc. — call{" "}
                    <code class="rounded bg-secondary px-2 py-0.5 font-mono text-sm text-foreground">Witnes.identify()</code>{" "}
                    once the user has authenticated.
                  </p>
                  <div class="rounded-xl border border-border bg-zinc-950 overflow-hidden code-block">
                    <div class="flex items-center justify-between border-b border-zinc-800 px-4 py-3">
                      <div class="flex items-center gap-2">
                        <div class="flex items-center gap-1.5">
                          <div class="h-2.5 w-2.5 rounded-full bg-zinc-700"></div>
                          <div class="h-2.5 w-2.5 rounded-full bg-zinc-700"></div>
                          <div class="h-2.5 w-2.5 rounded-full bg-zinc-700"></div>
                        </div>
                        <span class="ml-3 text-xs font-medium text-zinc-400">app.js</span>
                      </div>
                      <button class="copy-btn text-zinc-500 hover:text-zinc-300 transition-colors" aria-label="Copy code">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
                      </button>
                    </div>
                    <div class="p-5">
                      <pre class="overflow-x-auto text-sm leading-7"><code><span class="text-zinc-500 italic">// After your login logic completes</span>
<span class="text-zinc-300">window.</span><span class="text-blue-400">Witnes</span><span class="text-zinc-300">.</span><span class="text-blue-400">identify</span><span class="text-zinc-300">(</span><span class="text-emerald-400">"user_4821"</span><span class="text-zinc-300">);</span></code></pre>
                    </div>
                  </div>
                </div>

                <!-- Option C: Guest Mode -->
                <div>
                  <div class="flex items-center gap-3 mb-3">
                    <span class="flex h-6 w-6 items-center justify-center rounded-full bg-secondary text-xs font-semibold text-foreground">C</span>
                    <h3 class="text-base font-semibold text-foreground">Guest Mode — no identification needed</h3>
                  </div>
                  <p class="text-sm text-muted-foreground pl-9">
                    If you don't pass a{" "}
                    <code class="rounded bg-secondary px-2 py-0.5 font-mono text-sm text-foreground">userId</code>{" "}
                    and don't call{" "}
                    <code class="rounded bg-secondary px-2 py-0.5 font-mono text-sm text-foreground">identify()</code>, Witnes automatically assigns a persistent guest ID (prefixed with{" "}
                    <code class="rounded bg-secondary px-2 py-0.5 font-mono text-sm text-foreground">w-gid_</code>)
                    stored in localStorage. This lets you track anonymous visitors across sessions without any extra code.
                  </p>
                </div>
              </div>
            </div>

            <!-- Divider -->
            <div class="h-px bg-border"></div>

            <!-- 03: Billing -->
            <div>
              <div class="flex items-baseline gap-4 mb-4">
                <span
                  class="text-4xl font-extralight text-muted-foreground/40 font-mono"
                  >03</span
                >
                <p
                  class="text-sm font-semibold uppercase tracking-widest text-muted-foreground"
                >
                  Billing
                </p>
              </div>
              <h2
                class="text-2xl font-bold tracking-tight text-foreground md:text-3xl"
              >
                How Billing Works
              </h2>
              <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
                Witnes calculates usage based on <strong class="text-foreground"
                  >Units</strong
                >.
              </p>

              <div
                class="mt-8 rounded-xl border border-border bg-secondary/50 p-8 text-center"
              >
                <p class="text-3xl font-bold text-foreground">
                  1 Unit = 50 Page Loads
                </p>
              </div>

              <div class="mt-8">
                <h3 class="text-base font-semibold text-foreground mb-4">
                  Tracked Page Loads
                </h3>
                <div class="grid gap-4 sm:grid-cols-2">
                  <div class="rounded-lg border border-border p-5">
                    <p
                      class="font-mono text-sm font-semibold text-foreground mb-1"
                    >
                      LOAD
                    </p>
                    <p class="text-sm text-muted-foreground">
                      Triggered when a page is first opened.
                    </p>
                  </div>
                  <div class="rounded-lg border border-border p-5">
                    <p
                      class="font-mono text-sm font-semibold text-foreground mb-1"
                    >
                      SPA_NAV
                    </p>
                    <p class="text-sm text-muted-foreground">
                      Triggered when the URL changes (even without a page
                      reload).
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Divider -->
            <div class="h-px bg-border"></div>

            <!-- 04: Browser Coverage -->
            <div>
              <div class="flex items-baseline gap-4 mb-4">
                <span
                  class="text-4xl font-extralight text-muted-foreground/40 font-mono"
                  >04</span
                >
                <p
                  class="text-sm font-semibold uppercase tracking-widest text-muted-foreground"
                >
                  Compatibility
                </p>
              </div>
              <h2
                class="text-2xl font-bold tracking-tight text-foreground md:text-3xl"
              >
                Browser Coverage
              </h2>
              <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
                We support all modern browsers. Some advanced metrics are
                subject to browser API availability.
              </p>

              <div class="mt-8 overflow-x-auto rounded-xl border border-border">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-border bg-secondary/50">
                      <th
                        class="px-4 py-3 text-left font-semibold text-foreground"
                        >Feature</th
                      >
                      <th
                        class="px-3 py-3 text-center font-semibold text-foreground"
                        >Chrome</th
                      >
                      <th
                        class="px-3 py-3 text-center font-semibold text-foreground"
                        >Edge</th
                      >
                      <th
                        class="px-3 py-3 text-center font-semibold text-foreground"
                        >Safari</th
                      >
                      <th
                        class="px-3 py-3 text-center font-semibold text-foreground"
                        >Firefox</th
                      >
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-border">
                    <tr>
                      <td class="px-4 py-3 font-medium text-foreground"
                        >Session Tracking</td
                      >
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-amber-600"
                        >Expected</td
                      >
                    </tr>
                    <tr>
                      <td class="px-4 py-3 font-medium text-foreground">LCP</td>
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-amber-600"
                        >Expected</td
                      >
                    </tr>
                    <tr>
                      <td class="px-4 py-3 font-medium text-foreground">CLS</td>
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-amber-600"
                        >Expected</td
                      >
                    </tr>
                    <tr>
                      <td class="px-4 py-3 font-medium text-foreground">FCP</td>
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-amber-600"
                        >Expected</td
                      >
                    </tr>
                    <tr>
                      <td class="px-4 py-3 font-medium text-foreground"
                        >Long Tasks</td
                      >
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-zinc-400">N/A</td>
                      <td class="px-3 py-3 text-center text-amber-600"
                        >Expected</td
                      >
                    </tr>
                    <tr>
                      <td class="px-4 py-3 font-medium text-foreground"
                        >Resource Timing</td
                      >
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-amber-600"
                        >Partial</td
                      >
                      <td class="px-3 py-3 text-center text-amber-600"
                        >Expected</td
                      >
                    </tr>
                    <tr>
                      <td class="px-4 py-3 font-medium text-foreground"
                        >Network Info</td
                      >
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-zinc-400">N/A</td>
                      <td class="px-3 py-3 text-center text-zinc-400">N/A</td>
                    </tr>
                    <tr>
                      <td class="px-4 py-3 font-medium text-foreground"
                        >sendBeacon</td
                      >
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-emerald-600"
                        >Tested</td
                      >
                      <td class="px-3 py-3 text-center text-amber-600"
                        >Expected</td
                      >
                    </tr>
                  </tbody>
                </table>
              </div>
              <div class="mt-4 space-y-1 text-xs text-muted-foreground">
                <p>Tested Versions: Chrome 131, Edge 131, Safari 18.5</p>
                <p>Expected: Firefox 133+ per MDN compatibility data</p>
                <p>
                  Safari: LCP support added in Safari 18.2 / macOS 15.2
                  (December 2024)
                </p>
              </div>
            </div>

            <!-- Divider -->
            <div class="h-px bg-border"></div>

            <!-- 05: Technical Details -->
            <div>
              <div class="flex items-baseline gap-4 mb-4">
                <span
                  class="text-4xl font-extralight text-muted-foreground/40 font-mono"
                  >05</span
                >
                <p
                  class="text-sm font-semibold uppercase tracking-widest text-muted-foreground"
                >
                  Under the Hood
                </p>
              </div>
              <h2
                class="text-2xl font-bold tracking-tight text-foreground md:text-3xl"
              >
                Technical Details
              </h2>

              <div class="mt-8 grid gap-6 sm:grid-cols-2">
                <!-- Performance -->
                <div class="space-y-4">
                  <h3 class="text-base font-semibold text-foreground">
                    Performance
                  </h3>
                  <ul class="space-y-3">
                    <li class="flex gap-3 text-sm text-muted-foreground">
                      <span
                        class="inline-block h-1 w-1 mt-2 rounded-full bg-foreground/40 shrink-0"
                      ></span>
                      <span
                        ><strong class="text-foreground">Zero Blocking</strong> —
                        Uses{" "}
                        <code
                          class="rounded bg-secondary px-1.5 py-0.5 font-mono text-xs text-foreground"
                          >async</code
                        >{" "}
                        and{" "}
                        <code
                          class="rounded bg-secondary px-1.5 py-0.5 font-mono text-xs text-foreground"
                          >sendBeacon</code
                        >. Never slows your page.</span
                      >
                    </li>
                    <li class="flex gap-3 text-sm text-muted-foreground">
                      <span
                        class="inline-block h-1 w-1 mt-2 rounded-full bg-foreground/40 shrink-0"
                      ></span>
                      <span
                        ><strong class="text-foreground">Lightweight</strong> — &lt;
                        1KB gzipped.</span
                      >
                    </li>
                  </ul>
                </div>

                <!-- Security -->
                <div class="space-y-4">
                  <h3 class="text-base font-semibold text-foreground">
                    Security & Privacy
                  </h3>
                  <ul class="space-y-3">
                    <li class="flex gap-3 text-sm text-muted-foreground">
                      <span
                        class="inline-block h-1 w-1 mt-2 rounded-full bg-foreground/40 shrink-0"
                      ></span>
                      <span
                        ><strong class="text-foreground">Project Key</strong> — Routes
