---
import "../styles/dashboard.css";

export interface Props {
  title: string;
}

const { title } = Astro.props;
const trackingUrl =
  import.meta.env.PUBLIC_WITNES_TRACKING_URL ||
  "https://cdn.witnes.io/w.min.js";
const projectKey =
  import.meta.env.PUBLIC_WITNES_PROJECT_KEY ||
  "pk_4705e0d771ff461f8e58027b880cf96e";
const trackingDebug = import.meta.env.PUBLIC_WITNES_DEBUG_MODE === "false";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Witnes Dashboard" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <style>
      /* Force font-weight consistency */
      .font-black {
        font-weight: 900 !important;
      }
    </style>
    <title>{title}</title>
    <script is:inline define:vars={{ projectKey, trackingDebug }}>
      window.witnesConfig = {
        projectKey: projectKey,
        debug: true,
      };
    </script>
    <script src={trackingUrl} async is:inline></script>
    <script is:inline>
      window.$crisp = [];
      window.CRISP_WEBSITE_ID = "9946e8a6-7f11-456f-8b6e-53e7df8683f4";
      (function () {
        d = document;
        s = d.createElement("script");
        s.src = "https://client.crisp.chat/l.js";
        s.async = 1;
        d.getElementsByTagName("head")[0].appendChild(s);
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
