---
import PricingButtons from "./PricingButtons";

const plans = [
  {
    name: "Starter",
    description: "Perfect for small teams getting started",
    price: "€29",
    period: "/month",
    credits: "50k credits",
    creditsSubtext: "2.5M page loads",
    features: [
      "2 team members",
      "7-day data retention",
      "Full session timeline",
      "API latency tracking",
      "Network diagnostics",
    ],
  },
  {
    name: "Growth",
    description: "For growing teams with higher volume",
    price: "€80",
    period: "/month",
    credits: "100k credits",
    creditsSubtext: "5M page loads",
    features: [
      "4 team members",
      "14-day data retention",
      "Full session timeline",
      "API latency tracking",
      "Network diagnostics",
      "Priority support",
    ],
    popular: false,
  },
];
---

<section id="pricing" class="relative py-24 md:py-32">
  <div
    class="pointer-events-none absolute left-1/2 top-0 -translate-x-1/2 h-px w-2/3 bg-gradient-to-r from-transparent via-border to-transparent"
  >
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-2xl text-center">
      <div
        class="mb-4 inline-flex items-center gap-2 rounded-full border border-border bg-secondary px-4 py-1.5 text-sm text-foreground"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-3.5 w-3.5"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 6v6l4 2"></path>
        </svg>
        <span>Pricing</span>
      </div>
      <h2
        class="text-balance text-3xl font-bold tracking-tight text-foreground md:text-4xl lg:text-5xl"
      >
        Simple, transparent pricing
      </h2>
      <p class="mt-6 text-pretty text-lg leading-relaxed text-muted-foreground">
        Start with a 7-day free trial. No credit card required. Cancel anytime.
      </p>
    </div>

    <div class="mt-16 grid gap-8 md:grid-cols-2 lg:gap-8">
      {
        plans.map((plan) => (
          <div
            class={`group relative flex flex-col rounded-2xl border bg-card p-8 shadow-sm transition-all hover:shadow-md ${
              plan.popular
                ? "border-primary/50 shadow-md ring-1 ring-primary/10"
                : "border-border hover:border-border/80"
            }`}
          >
            {plan.popular && (
              <div class="absolute -top-4 left-1/2 -translate-x-1/2">
                <div class="flex items-center gap-1 rounded-full border border-primary bg-primary px-3 py-1 text-xs font-semibold text-primary-foreground shadow-sm">
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="h-3 w-3"
                  >
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                  </svg>
                  <span>Most Popular</span>
                </div>
              </div>
            )}

            <div class="mb-5">
              <h3 class="text-2xl font-bold tracking-tight text-foreground">
                {plan.name}
              </h3>
              <p class="mt-2 text-sm text-muted-foreground">
                {plan.description}
              </p>
            </div>

            <div class="mb-6">
              <div class="flex items-baseline gap-1">
                <span class="text-5xl font-bold tracking-tight text-foreground">
                  {plan.price}
                </span>
                <span class="text-lg text-muted-foreground">{plan.period}</span>
              </div>
              <div class="mt-3 rounded-lg bg-secondary/50 px-3 py-2">
                <p class="text-sm font-semibold text-foreground">
                  {plan.credits}
                </p>
                <p class="text-xs text-muted-foreground">
                  {plan.creditsSubtext}
                </p>
              </div>
            </div>

            <div class="mb-8">
              <PricingButtons client:load planName={plan.name} />
            </div>

            <div class="flex-1">
              <div class="mb-4 flex items-center gap-2">
                <div class="h-px flex-1 bg-border" />
                <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                  Features
                </span>
                <div class="h-px flex-1 bg-border" />
              </div>
              <ul class="space-y-3">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-3">
                    <svg
                      class="mt-0.5 h-5 w-5 shrink-0 text-primary"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    <span class="text-sm leading-relaxed text-foreground">
                      {feature}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Enterprise CTA -->
    <div class="mt-16 text-center">
      <div
        class="mx-auto max-w-2xl overflow-hidden rounded-2xl border border-border bg-gradient-to-br from-card to-secondary/20 p-10 shadow-sm"
      >
        <div
          class="mb-4 inline-flex items-center gap-2 rounded-full border border-border bg-background px-4 py-1.5 text-xs font-semibold text-foreground"
        >
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="20" height="14" x="2" y="7" rx="2" ry="2"></rect>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
          </svg>
          <span>Enterprise</span>
        </div>
        <h3 class="text-3xl font-bold text-foreground">Need more?</h3>
        <p class="mx-auto mt-3 max-w-md text-pretty text-muted-foreground">
          Custom plans for larger teams with advanced features, dedicated
          support, and flexible pricing.
        </p>
        <div
          class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row"
        >
          <a
            href="mailto:sales@witnes.io"
            class="inline-flex items-center justify-center gap-2 rounded-lg border border-border bg-background px-6 py-3 text-sm font-medium text-foreground shadow-sm transition-all hover:bg-secondary hover:shadow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            Contact sales
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
